# NAS deployment environment values. Copy to `.env.nas`, fill in real values, and do
# NOT commit `.env.nas` (already covered by .gitignore's ".env" pattern - keep the
# filename starting with ".env" so that pattern still matches, or add an explicit
# ".env.nas" line to .gitignore if you rename it).
#
# Used with: sudo docker compose -p urban_renewal_new -f docker-compose.nas.yml --env-file .env.nas up -d --build

# Database - a dedicated database + user, NOT the old production app's credentials
# and NOT another app's database on this NAS. Connects over TCP to a MariaDB
# container with an explicitly/deliberately mapped host port (do not assume host
# port 3306 is free on this NAS - see 後端開發_CLAUDE.md for why).
DB_HOST=192.168.0.20
DB_PORT=13306
DB_NAME=urban_renewal
DB_USER=change_me
DB_PASSWORD=change_me_to_the_password_you_set_on_the_nas

# JWT - generate a real random secret for this, don't reuse the local dev one.
JWT_SECRET=change_me_to_a_long_random_string
JWT_EXPIRE_MINUTES=480

# App
CORS_ORIGINS=https://honerAI.synology.me
ALERT_UNCONTACTED_DAYS=14

# Seed admin account (created on first API startup if no admin exists)
ADMIN_INITIAL_PASSWORD=Admin@2026

# OpenAI API key (from https://platform.openai.com/api-keys), used for OCR when
# scanning a 土地登記謄本. Leave blank to disable OCR (the button will show an error).
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

# OCR 文字辨識引擎:local(預設,RapidOCR)/ google_vision(Cloud Vision,繁中很準,
# 免費 1000 units/月)。google_vision 需在 GCP 建專案、啟用 Cloud Vision API、產 API key。
OCR_TEXT_PROVIDER=local
GOOGLE_VISION_API_KEY=

# 謄本結構化擷取用哪個 LLM:openai(預設)/ gemini / qwen / bedrock。OCR 文字辨識不受影響。
# 注意:gemini 與 bedrock 免費/試用層都有「每日 token 上限」,一份掃描謄本會用掉好幾次
# 呼叫,不夠跑正式量;正式用請先在該平台開啟計費。
OCR_LLM_PROVIDER=openai
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
INVOICE_USE_GEMINI=false
# Amazon Bedrock(OCR_LLM_PROVIDER=bedrock 時)。TOKEN 從 AWS console 的 Bedrock API keys 產生。
AWS_BEARER_TOKEN_BEDROCK=
BEDROCK_REGION=us-east-1
BEDROCK_MODEL=us.anthropic.claude-sonnet-4-6
# 阿里雲 DashScope Qwen-VL(OCR_LLM_PROVIDER=qwen 時)。新帳號有免費 token 額度。
# 中國站 base URL 改 https://dashscope.aliyuncs.com/compatible-mode/v1
DASHSCOPE_API_KEY=
DASHSCOPE_MODEL=qwen-vl-max
DASHSCOPE_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1

# 發票辨識:轉發到有 GPU 的機器上跑的 ocr_service.py(NAS 本機不跑 PaddleOCR,會 OOM)。
# 留空 = 不用遠端(此時發票辨識只支援掃 QR code)。
# URL 用該機器的 Tailscale 主機名 / IP,SECRET 兩邊要一致(隨機字串)。
OCR_REMOTE_URL=
OCR_REMOTE_SECRET=
